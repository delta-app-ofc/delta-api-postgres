DB_URL=jdbc:postgresql://url-do-neon/bancododelta?sslmode=require
DB_USERNAME=seu_user
DB_PASSWORD=sua_senha

# Redis: REDIS_DATABASE deve ser um índice numérico (normalmente 0).
REDIS_HOST=host-do-redis
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=sua_senha
REDIS_DATABASE=0
REDIS_SSL_ENABLED=true
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s

# Autenticação/JWT
AUTH_PRIVATE_KEY=file:./.local/private.pem
AUTH_PUBLIC_KEY=file:./.local/public.pem
AUTH_ISSUER=delta-api
AUTH_AUDIENCE=delta-api
AUTH_KEY_ID=delta-1

# CORS e proteção das rotas de autenticação
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_ATTEMPTS_PER_MINUTE=30

# Validade do refresh token no formato ISO-8601
AUTH_REFRESH_TTL=P30D