DB_URL=jdbc:postgresql://url-do-neon/bancododelta?sslmode=require
DB_USERNAME=seu_user
DB_PASSWORD=sua_senha

# Redis: REDIS_DATABASE deve ser um índice numérico (normalmente 0).
REDIS_HOST=host-do-redis
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=sua_senha
REDIS_DATABASE=0
REDIS_SSL_ENABLED=true
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s
